# The public host name of the update server (a DNS A/AAAA record pointing here).
OTA_HOST=
# The management and upload token; the publisher (ota-publish.yml) holds the same
# value as the secret HOT_UPDATER_AUTH_TOKEN. openssl rand -hex 32
HOT_UPDATER_AUTH_TOKEN=
# https in production; http only for a local trial without certificates.
SITE_SCHEME=https
# The server image tag (a host pulls keyring-ota/server:<tag> from its registry).
# Empty: the locally built :local image.
OTA_IMAGE_TAG=
