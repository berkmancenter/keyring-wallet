# Copy to .env (gitignored) and fill in. docker compose reads .env from this
# directory. Nothing in this file is a secret value; the secrets are files in
# ./secrets (README "Secrets to place").

###############################################################################
# Hostname and ports
###############################################################################

# Public hostname of the push wake-up gateway, no scheme. Needs a public DNS
# A/AAAA record pointing at this server. Example: push.example.org
# For a local run: localhost (README "Local testing").
GATEWAY_HOST=

# https (default): Caddy gets certificates automatically.
# http: a local run, or behind a tunnel that terminates TLS (README "Local testing").
SITE_SCHEME=https

# Host ports Caddy publishes. Keep 80/443 on a server (ACME needs them).
HTTP_PORT=80
HTTPS_PORT=443

###############################################################################
# Push gateway (OpenVTC/vti-push-gateway)
###############################################################################

# Full 40-character commit of vti-push-gateway to build. Bump deliberately, and
# only together with the agents the gateway serves (README "Updating").
GATEWAY_COMMIT=e542a9d77a7369f4f3da01d573107ea155c80691

# The controller VTAs (agents) this gateway serves: exact DIDs, separated by
# commas or spaces. No patterns. Unset or empty = every push/register is
# refused. `*` = open mode (any agent may register; startup warning; every
# other bound still applies). Which one production uses is not decided
# (docs/plans/push-notifications-plan.md §5.4).
GATEWAY_ALLOWED_CONTROLLERS=

# The gateway's provisioned did:webvh identity (JSON), as a path INSIDE the
# container: files in ./secrets appear under /run/secrets/gateway/.
# Blank = HTTPS-only: the gateway serves push/register and nothing an agent
# can reach, because agents wake only a gateway named by a DID.
# Example: /run/secrets/gateway/gateway-identity.json (README "Gateway identity")
GATEWAY_IDENTITY_FILE=

# APNs token-auth key (.p8) path inside the container, its Key ID and the Apple
# Developer Team ID. All three, or none (APNs disabled). The ids are not
# secret; the .p8 is. Example: /run/secrets/gateway/AuthKey_ABC123DEFG.p8
# Sandbox or production is chosen per registration by the app, not here.
GATEWAY_APNS_KEY_FILE=
GATEWAY_APNS_KEY_ID=
GATEWAY_APNS_TEAM_ID=

# APNs topics (bundle ids) registrations may name, comma-separated. The test
# app is asml.bkc.harvard.wallet.pushtest; the release app,
# asml.bkc.harvard.wallet, is added only after the test passes.
GATEWAY_APNS_TOPICS=asml.bkc.harvard.wallet.pushtest

# Firebase service-account JSON path inside the container. Blank = FCM
# disabled. Example: /run/secrets/gateway/fcm-service-account.json
GATEWAY_FCM_SERVICE_ACCOUNT_FILE=

# Visible alert mode (gateway/patches/0001): with GATEWAY_ALERT_LOC_KEY set, an
# interactive wake (an approval waiting) is shown by the phone's system as a
# notification, from the app's own string for this key; background wakes stay
# silent. Keyring's app defines KEYRING_WAKE (one neutral line, every language).
# Blank = every wake silent.
GATEWAY_ALERT_LOC_KEY=
GATEWAY_ALERT_TITLE_LOC_KEY=
GATEWAY_ALERT_COLLAPSE_ID=keyring-wake
GATEWAY_FCM_ANDROID_CHANNEL_ID=

# 1 = refuse to start when a secret file is readable beyond its owner (uid
# 10001 in the container). Keep 1 on a server.
GATEWAY_STRICT_KEY_PERMS=1

# 1 = register the dev echo sender: logs wakes and delivers NOTHING, for every
# platform, and reports them `delivered`. For the credential-free first run
# only (README "First run"). Leave blank otherwise: with it on, a wake for a
# platform with no credentials looks successful and is silently dropped.
GATEWAY_DEV_ECHO_SENDER=

# Per-peer-IP HTTP rate limit on POST /trust-tasks. Behind Caddy all HTTPS
# callers share one peer address, so this is a global limit in practice; the
# gateway's defaults (10/s, burst 40) are too low for that.
GATEWAY_HTTP_PER_SEC=100
GATEWAY_HTTP_BURST=400

# RUST_LOG filter for the gateway. Blank = vti_push_gateway=info,tower_http=info
GATEWAY_LOG=
