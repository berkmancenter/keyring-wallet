 //!   the startup log warns, and every other bound (per-controller handle cap,
 //!   the replay record's per-issuer, per-handle and fair-share budgets) still
 //!   applies.
+//!
+//! Optionally, `GATEWAY_ALLOWED_CONTROLLER_HOSTS` adds DID **hosts** for a
+//! deployment whose DID hosts are closed — only the operator's own VTAs can
+//! publish there — so "the controller's DID lives on this host" means "the
+//! operator created it". A `did:webvh` or `did:web` controller whose host
+//! matches is served alongside the exact list. Entries are an exact host
+//! (`dids.example.org`) or `*.` plus at least two labels (`*.example.org`,
+//! subdomains only, never the apex). DID methods without a host (`did:key`,
+//! `did:peer`) are matched by the exact list only. On an open DID host this
+//! admits every DID anyone can publish there: use it only where publishing
+//! is controlled.
 
 use std::collections::HashSet;
 
 /// Env var holding the controller allowlist.
 pub const ENV_ALLOWED_CONTROLLERS: &str = "GATEWAY_ALLOWED_CONTROLLERS";
 
+/// Env var holding the optional controller DID-host allowlist.
+pub const ENV_ALLOWED_CONTROLLER_HOSTS: &str = "GATEWAY_ALLOWED_CONTROLLER_HOSTS";
+
+/// One entry of [`ENV_ALLOWED_CONTROLLER_HOSTS`].
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum HostPattern {
+    /// This host exactly.
+    Exact(String),
+    /// Any subdomain of this suffix (stored without the leading `*.`); never
+    /// the suffix itself.
+    Subdomains(String),
+}
+
+impl HostPattern {
+    fn parse(entry: &str) -> Result<Self, String> {
+        let e = entry.to_ascii_lowercase();
+        let (wild, host) = match e.strip_prefix("*.") {
+            Some(rest) => (true, rest),
+            None => (false, e.as_str()),
+        };
+        let labels: Vec<&str> = host.split('.').collect();
+        let valid_label = |l: &&str| {
+            !l.is_empty()
+                && l.len() <= 63
+                && !l.starts_with('-')
+                && !l.ends_with('-')
+                && l.chars().all(|c| c.is_ascii_alphanumeric() || c == '-')
+        };
+        if host.contains('*') || labels.len() < 2 || !labels.iter().all(valid_label) {
+            return Err(format!(
+                "{ENV_ALLOWED_CONTROLLER_HOSTS}: `{entry}` is not a host or `*.` host pattern \
+                 (a wildcard needs at least two labels after `*.`)"
+            ));
+        }
+        Ok(if wild {
+            Self::Subdomains(host.to_string())
+        } else {
+            Self::Exact(host.to_string())
+        })
+    }
+
+    fn matches(&self, host: &str) -> bool {
+        match self {
+            Self::Exact(h) => host == h,
+            Self::Subdomains(suffix) => host
+                .strip_suffix(suffix.as_str())
+                .is_some_and(|prefix| prefix.len() > 1 && prefix.ends_with('.')),
+        }
+    }
+}
+
+/// The host a `did:webvh` or `did:web` DID resolves from, lower-cased and
+/// without a port; `None` for other methods or a malformed DID.
+///
+/// - `did:webvh:<scid>:<host>[:<path>…]`
+/// - `did:web:<host>[:<path>…]`
+///
+/// The host segment may percent-encode a port (`example.org%3A8443`).
+pub fn did_host(did: &str) -> Option<String> {
+    let parts: Vec<&str> = did.split(':').collect();
+    let raw = match parts.as_slice() {
+        ["did", "webvh", scid, host, ..] if !scid.is_empty() => *host,
+        ["did", "web", host, ..] => *host,
+        _ => return None,
+    };
+    let host = raw
+        .split("%3A")
+        .next()
+        .and_then(|h| h.split("%3a").next())
+        .unwrap_or("")
+        .to_ascii_lowercase();
+    if host.is_empty() || host.contains('%') || host.contains('/') {
+        return None;
+    }
+    Some(host)
+}
+
 #[derive(Debug, Clone, PartialEq, Eq)]
 pub enum ControllerPolicy {
-    /// Only these controller DIDs (exact match). Empty admits no one.
-    Listed(HashSet<String>),
+    /// Only these controller DIDs (exact match), plus any `did:webvh` /
+    /// `did:web` controller on one of these hosts. Both empty admits no one.
+    Listed {
+        dids: HashSet<String>,
+        hosts: Vec<HostPattern>,
+    },
     /// Any controller (`*`). Explicit opt-in only.
     Open,
 }
@@ -32,7 +124,10 @@ pub enum ControllerPolicy {
