     }
 
-    /// Read [`ENV_ALLOWED_CONTROLLERS`].
+    /// Parse both env-var values: the DID list as [`Self::parse`], plus the
+    /// optional host list. Hosts next to open mode are an error (open mode
+    /// already admits everyone; mixing the two would hide a mistake).
+    pub fn parse_with_hosts(raw: Option<&str>, raw_hosts: Option<&str>) -> Result<Self, String> {
+        let policy = Self::parse(raw)?;
+        let hosts = raw_hosts
+            .unwrap_or("")
+            .split(|c: char| c == ',' || c.is_whitespace())
+            .filter(|e| !e.is_empty())
+            .map(HostPattern::parse)
+            .collect::<Result<Vec<_>, _>>()?;
+        match policy {
+            Self::Open if !hosts.is_empty() => Err(format!(
+                "{ENV_ALLOWED_CONTROLLER_HOSTS} cannot be combined with {ENV_ALLOWED_CONTROLLERS}=*"
+            )),
+            Self::Open => Ok(Self::Open),
+            Self::Listed { dids, .. } => Ok(Self::Listed { dids, hosts }),
+        }
+    }
+
+    /// Read [`ENV_ALLOWED_CONTROLLERS`] and [`ENV_ALLOWED_CONTROLLER_HOSTS`].
     pub fn from_env() -> Result<Self, String> {
-        Self::parse(std::env::var(ENV_ALLOWED_CONTROLLERS).ok().as_deref())
+        Self::parse_with_hosts(
+            std::env::var(ENV_ALLOWED_CONTROLLERS).ok().as_deref(),
+            std::env::var(ENV_ALLOWED_CONTROLLER_HOSTS).ok().as_deref(),
+        )
     }
 
     /// A policy listing exactly `dids`.
     pub fn listing<I: IntoIterator<Item = S>, S: Into<String>>(dids: I) -> Self {
-        Self::Listed(dids.into_iter().map(Into::into).collect())
+        Self::Listed {
+            dids: dids.into_iter().map(Into::into).collect(),
+            hosts: Vec::new(),
+        }
+    }
+
+    /// Whether nothing at all is admitted (no DIDs, no hosts).
+    pub fn admits_no_one(&self) -> bool {
+        matches!(self, Self::Listed { dids, hosts } if dids.is_empty() && hosts.is_empty())
     }
 
     /// Whether `did` may control handles on this gateway.
     pub fn allows(&self, did: &str) -> bool {
         match self {
             Self::Open => true,
-            Self::Listed(set) => set.contains(did),
+            Self::Listed { dids, hosts } => {
+                dids.contains(did)
+                    || (!hosts.is_empty()
+                        && did_host(did).is_some_and(|h| hosts.iter().any(|p| p.matches(&h))))
+            }
         }
     }
 
@@ -93,7 +226,17 @@ impl ControllerPolicy {
     pub fn summary(&self) -> String {
         match self {
             Self::Open => "open (any controller)".into(),
-            Self::Listed(set) => format!("{} listed", set.len()),
+            Self::Listed { dids, hosts } if hosts.is_empty() => format!("{} listed", dids.len()),
+            Self::Listed { dids, hosts } => {
+                let hosts: Vec<String> = hosts
+                    .iter()
+                    .map(|h| match h {
+                        HostPattern::Exact(h) => h.clone(),
+                        HostPattern::Subdomains(s) => format!("*.{s}"),
+                    })
+                    .collect();
+                format!("{} listed, hosts {}", dids.len(), hosts.join(","))
+            }
         }
     }
 }
