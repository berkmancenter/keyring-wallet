+    #[test]
+    fn did_host_reads_webvh_and_web_only() {
+        assert_eq!(
+            did_host("did:webvh:QmScid:dids.Example.org:agent").as_deref(),
+            Some("dids.example.org")
+        );
+        assert_eq!(
+            did_host("did:webvh:QmScid:dids.example.org%3A8443:agent").as_deref(),
+            Some("dids.example.org")
+        );
+        assert_eq!(
+            did_host("did:web:vta.example.org").as_deref(),
+            Some("vta.example.org")
+        );
+        assert_eq!(did_host("did:key:z6Mk"), None);
+        assert_eq!(did_host("did:peer:2.Vz6Mk"), None);
+        assert_eq!(did_host("did:webvh::dids.example.org"), None, "empty SCID");
+    }
+
+    #[test]
+    fn host_patterns_match_exact_hosts_and_subdomains_only() {
+        let p =
+            ControllerPolicy::parse_with_hosts(None, Some("dids.example.org, *.vtas.example.net"))
+                .unwrap();
+        assert!(p.allows("did:webvh:QmA:dids.example.org:alice"));
+        assert!(p.allows("did:web:dids.example.org"));
+        assert!(p.allows("did:webvh:QmB:x.vtas.example.net:bob"));
+        assert!(p.allows("did:webvh:QmB:a.b.vtas.example.net"));
+        // the apex of a wildcard, a look-alike, another host, a hostless method
+        assert!(!p.allows("did:webvh:QmC:vtas.example.net:carol"));
+        assert!(!p.allows("did:webvh:QmC:evilvtas.example.net:carol"));
+        assert!(!p.allows("did:webvh:QmC:other.example.org:carol"));
+        assert!(!p.allows("did:key:z6MkAnything"));
+        // exact DIDs still work next to hosts
+        let both = ControllerPolicy::parse_with_hosts(Some("did:key:zC"), Some("dids.example.org"))
+            .unwrap();
+        assert!(both.allows("did:key:zC"));
+        assert!(both.allows("did:webvh:QmA:dids.example.org"));
+    }
+
+    #[test]
+    fn host_patterns_are_validated() {
+        for bad in [
+            "*",
+            "*.org",
+            "example",
+            "https://dids.example.org",
+            "dids.example.org/x",
+            "*.*.example.org",
+            "-bad.example.org",
+            "dids.example.org:8443",
+        ] {
+            assert!(
+                ControllerPolicy::parse_with_hosts(None, Some(bad)).is_err(),
+                "{bad} should be refused"
+            );
+        }
+        assert!(
+            ControllerPolicy::parse_with_hosts(Some("*"), Some("dids.example.org")).is_err(),
+            "hosts next to open mode"
+        );
+        assert!(
+            ControllerPolicy::parse_with_hosts(Some("*"), None).unwrap() == ControllerPolicy::Open
+        );
+    }
+
+    #[test]
+    fn admits_no_one_only_when_both_lists_are_empty() {
+        assert!(ControllerPolicy::default().admits_no_one());
+        assert!(
+            !ControllerPolicy::parse_with_hosts(None, Some("dids.example.org"))
+                .unwrap()
+                .admits_no_one()
+        );
+        assert!(!ControllerPolicy::Open.admits_no_one());
+    }
