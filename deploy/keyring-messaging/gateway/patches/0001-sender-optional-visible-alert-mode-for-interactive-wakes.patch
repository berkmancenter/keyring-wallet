+// ── Visible alert mode (optional) ───────────────────────────────────────────
+
+/// Optional **visible alert mode** for the APNs and FCM senders.
+///
+/// By default a wake is a silent background push (APNs `content-available`,
+/// FCM data-only), and the device wakes and drains its mediator. On iOS that
+/// is best effort: Apple says the system "may throttle the delivery of
+/// background notifications if the total number becomes excessive", advises
+/// "don't try to send more than two or three per hour", and "If something force
+/// quits or kills the app, the system discards the held notification"
+/// (*Pushing background updates to your App*). A wake that a person is waiting
+/// on — an approval — cannot depend on that.
+///
+/// With this mode configured, an **interactive** wake is sent as a notification
+/// the platform displays itself, whatever state the app is in: an APNs `alert`
+/// push and an FCM notification message. It stays contentless in the binding's
+/// sense: the payload names a **localisation key**, never text, and the device
+/// shows its own string for that key ("store your message strings in the
+/// Localizable.strings file of your app bundle and use the … loc-key payload
+/// keys", *Generating a remote notification*; FCM `body_loc_key` names an app
+/// string resource). The wake's hint fields ride along as before. Background
+/// wakes are unchanged.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct VisibleAlert {
+    /// The one line shown: APNs `aps.alert.loc-key`, FCM
+    /// `android.notification.body_loc_key`.
+    pub loc_key: String,
+    /// Optional title: APNs `aps.alert.title-loc-key`, FCM `title_loc_key`.
+    pub title_loc_key: Option<String>,
+    /// Merges repeated wakes into one notification: `apns-collapse-id`, FCM
+    /// `android.collapse_key` and `android.notification.tag`; also the APNs
+    /// `thread-id`.
+    pub collapse_id: String,
+    /// Android notification channel for the displayed notification.
+    pub android_channel_id: Option<String>,
+}
+
+/// Upper bound on a localisation key or channel id we pass through.
+const MAX_ALERT_KEY_LEN: usize = 128;
+/// APNs rejects an `apns-collapse-id` longer than 64 bytes.
+const MAX_COLLAPSE_ID_LEN: usize = 64;
+
+fn is_alert_key(s: &str, max: usize) -> bool {
+    !s.is_empty()
+        && s.len() <= max
+        && s.bytes()
+            .all(|b| b.is_ascii_alphanumeric() || matches!(b, b'.' | b'_' | b'-'))
+}
+
+impl VisibleAlert {
+    /// Validate the operator's configuration: every key is 1–128 characters of
+    /// `[A-Za-z0-9._-]`, and the collapse id at most 64.
+    pub fn new(
+        loc_key: String,
+        title_loc_key: Option<String>,
+        collapse_id: String,
+        android_channel_id: Option<String>,
+    ) -> Result<Self, String> {
+        if !is_alert_key(&loc_key, MAX_ALERT_KEY_LEN) {
+            return Err("alert loc-key must be 1-128 characters of [A-Za-z0-9._-]".into());
+        }
+        if let Some(t) = &title_loc_key {
+            if !is_alert_key(t, MAX_ALERT_KEY_LEN) {
+                return Err(
+                    "alert title loc-key must be 1-128 characters of [A-Za-z0-9._-]".into(),
+                );
+            }
+        }
+        if !is_alert_key(&collapse_id, MAX_COLLAPSE_ID_LEN) {
+            return Err("alert collapse id must be 1-64 characters of [A-Za-z0-9._-]".into());
+        }
+        if let Some(c) = &android_channel_id {
+            if !is_alert_key(c, MAX_ALERT_KEY_LEN) {
+                return Err("Android channel id must be 1-128 characters of [A-Za-z0-9._-]".into());
+            }
+        }
+        Ok(Self {
+            loc_key,
+            title_loc_key,
+            collapse_id,
+            android_channel_id,
+        })
+    }
+}
+
+/// The alert to show for this wake: only an interactive wake is made visible.
+fn visible_for<'a>(
+    alert: Option<&'a VisibleAlert>,
+    payload: &WakePayload,
+) -> Option<&'a VisibleAlert> {
+    alert.filter(|_| matches!(payload.urgency, Some(Urgency::Interactive)))
+}
+
+/// The APNs request for a wake: its push-type / priority / collapse headers and
+/// its JSON body. The wake's hint fields ride as custom keys (binding §2).
+fn apns_request(
+    payload: &WakePayload,
+    alert: Option<&VisibleAlert>,
+) -> (Vec<(&'static str, String)>, serde_json::Value) {
+    let mut body = match serde_json::to_value(payload) {
+        Ok(serde_json::Value::Object(m)) => m,
+        _ => serde_json::Map::new(),
+    };
+    match visible_for(alert, payload) {
+        None => {
+            // Contentless background push: the `aps` content-available flag
+            // wakes the app. Background pushes MUST be priority 5.
+            body.insert(
+                "aps".to_string(),
+                serde_json::json!({ "content-available": 1 }),
+            );
+            (
+                vec![
+                    ("apns-push-type", "background".to_string()),
+                    ("apns-priority", "5".to_string()),
+                ],
+                serde_json::Value::Object(body),
+            )
+        }
+        Some(a) => {
+            let mut shown = serde_json::Map::new();
+            shown.insert("loc-key".to_string(), a.loc_key.clone().into());
+            if let Some(t) = &a.title_loc_key {
+                shown.insert("title-loc-key".to_string(), t.clone().into());
+            }
+            // Displayed by the system from the app's own strings; still
+            // `content-available`, so a running app is told as before.
+            body.insert(
+                "aps".to_string(),
+                serde_json::json!({
+                    "alert": serde_json::Value::Object(shown),
+                    "sound": "default",
+                    "thread-id": a.collapse_id,
+                    "content-available": 1,
+                }),
+            );
+            (
+                vec![
+                    ("apns-push-type", "alert".to_string()),
+                    ("apns-priority", "10".to_string()),
+                    ("apns-collapse-id", a.collapse_id.clone()),
+                ],
+                serde_json::Value::Object(body),
+            )
+        }
+    }
+}
+
+/// The FCM HTTP v1 `message` for a wake. `data` values MUST be strings, so the
+/// hint fields are stringified (binding §2: no task content, no handle, no task
+/// type); `android.priority: high` wakes a backgrounded app.
+fn fcm_message(
+    token: &str,
+    payload: &WakePayload,
+    alert: Option<&VisibleAlert>,
+) -> serde_json::Value {
+    let mut data = serde_json::Map::new();
+    data.insert("v".to_string(), payload.v.to_string().into());
+    if let Some(m) = &payload.mediator {
+        data.insert("mediator".to_string(), m.clone().into());
+    }
+    if let Some(c) = payload.count {
+        data.insert("count".to_string(), c.to_string().into());
+    }
+    if let Some(u) = payload.urgency {
+        let s = match u {
+            Urgency::Interactive => "interactive",
+            Urgency::Background => "background",
+        };
+        data.insert("urgency".to_string(), s.into());
+    }
+    let mut android = serde_json::Map::new();
+    // High priority so a backgrounded app is woken now (the doorbell).
+    android.insert("priority".to_string(), "high".into());
+    if let Some(a) = visible_for(alert, payload) {
+        // A notification message: the system tray shows it from the app's
+        // string resource while the app is in the background or closed.
+        let mut notification = serde_json::Map::new();
+        notification.insert("body_loc_key".to_string(), a.loc_key.clone().into());
+        if let Some(t) = &a.title_loc_key {
+            notification.insert("title_loc_key".to_string(), t.clone().into());
+        }
+        if let Some(c) = &a.android_channel_id {
+            notification.insert("channel_id".to_string(), c.clone().into());
+        }
+        notification.insert("tag".to_string(), a.collapse_id.clone().into());
+        android.insert("collapse_key".to_string(), a.collapse_id.clone().into());
+        android.insert(
+            "notification".to_string(),
+            serde_json::Value::Object(notification),
+        );
+    }
+    serde_json::json!({
+        "message": {
+            "token": token,
+            "data": data,
+            "android": serde_json::Value::Object(android),
+        }
+    })
+}
