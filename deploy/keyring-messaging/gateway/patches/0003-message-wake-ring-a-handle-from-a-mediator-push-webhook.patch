@@ -0,0 +1,260 @@
+//! The mediator webhook: a message queued at a mediator rings the handle's
+//! device, as the gateway's own trigger, once per interval, each with its own
+//! collapse id.
+
+use std::sync::{Arc, Mutex};
+use std::time::Duration;
+
+use affinidi_did_resolver_cache_sdk::{config::DIDCacheConfigBuilder, DIDCacheClient};
+use axum::body::Body;
+use axum::http::{Request, StatusCode};
+use axum::Router;
+use http_body_util::BodyExt;
+use serde_json::{json, Value};
+use tower::ServiceExt;
+
+use vti_push_gateway::api::AppState;
+use vti_push_gateway::egress::EgressPolicy;
+use vti_push_gateway::limits::Limits;
+use vti_push_gateway::message_wake::{self, MessageWake};
+use vti_push_gateway::proof::ProofVerifier;
+use vti_push_gateway::sender::{PushSender, SendOutcome};
+use vti_push_gateway::store::{Store, WakeAuthz};
+use vti_push_gateway::types::{PushRegistration, Urgency, WakePayload, WakeTriggerPolicy};
+
+const GATEWAY_DID: &str = "did:webvh:scid:gateway.example";
+const VTA_DID: &str = "did:webvh:scid:vta.example";
+const SECRET: &str = "s3cret-s3cret-s3cret-s3cret-s3cret-0123";
+const HANDLE: &str = "handle-1";
+
+/// Records every wake it is asked to send; delivers, or reports a dead token.
+struct Recording {
+    sent: Arc<Mutex<Vec<WakePayload>>>,
+    dead: bool,
+}
+
+#[async_trait::async_trait]
+impl PushSender for Recording {
+    fn handles(&self, _registration: &PushRegistration) -> bool {
+        true
+    }
+    async fn send(&self, _registration: &PushRegistration, payload: &WakePayload) -> SendOutcome {
+        self.sent.lock().unwrap().push(payload.clone());
+        if self.dead {
+            SendOutcome::PermanentlyUnregistered
+        } else {
+            SendOutcome::Delivered
+        }
+    }
+}
+
+struct Setup {
+    app: Router,
+    store: Arc<Store>,
+    sent: Arc<Mutex<Vec<WakePayload>>>,
+}
+
+/// A gateway with one handle whose controller allowlisted `triggers`.
+async fn setup(
+    triggers: &[&str],
+    gateway_did: Option<&str>,
+    interval: Duration,
+    dead: bool,
+) -> Setup {
+    let store = Arc::new(Store::new());
+    store
+        .insert(
+            HANDLE.into(),
+            PushRegistration::Fcm {
+                token: "fcm-token".into(),
+            },
+            VTA_DID.into(),
+        )
+        .unwrap();
+    store.provision(
+        HANDLE,
+        VTA_DID,
+        WakeTriggerPolicy {
+            allowed_triggers: triggers.iter().map(|d| d.to_string()).collect(),
+        },
+    );
+    let sent = Arc::new(Mutex::new(Vec::new()));
+    let senders: Vec<Box<dyn PushSender>> = vec![Box::new(Recording {
+        sent: sent.clone(),
+        dead,
+    })];
+    let state = AppState {
+        store: store.clone(),
+        senders: Arc::new(senders),
+        gateway_addr: "https://gw.test".into(),
+        metrics: Arc::new(vti_push_gateway::metrics::Metrics::default()),
+        egress: Arc::new(EgressPolicy::default()),
+        limits: Arc::new(Limits::permissive()),
+        replay: Arc::new(vti_push_gateway::replay::ReplayRecord::default()),
+        controllers: Arc::new(vti_push_gateway::controllers::ControllerPolicy::Open),
+        proofs: ProofVerifier::new(Arc::new(
+            DIDCacheClient::new(DIDCacheConfigBuilder::default().build())
+                .await
+                .expect("resolver"),
+        )),
+        gateway_did: gateway_did.map(String::from),
+    };
+    let wake = MessageWake::new(SECRET.into(), interval).unwrap();
+    Setup {
+        app: message_wake::router(state, Arc::new(wake)),
+        store,
+        sent,
+    }
+}
+
+async fn allowed() -> Setup {
+    setup(
+        &[VTA_DID, GATEWAY_DID],
+        Some(GATEWAY_DID),
+        Duration::from_secs(30),
+        false,
+    )
+    .await
+}
+
+async fn post(app: &Router, secret: &str, body: Value) -> (StatusCode, Value) {
+    let req = Request::post(format!("/mediator-webhook/{secret}"))
+        .header("content-type", "application/json")
+        .body(Body::from(body.to_string()))
+        .unwrap();
+    let resp = app.clone().oneshot(req).await.unwrap();
+    let status = resp.status();
+    let bytes = resp.into_body().collect().await.unwrap().to_bytes();
+    (
+        status,
+        serde_json::from_slice(&bytes).unwrap_or(Value::Null),
+    )
+}
