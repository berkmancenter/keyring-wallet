+    let (status, v) = post(&s.app, SECRET, webhook(Some(HANDLE))).await;
+    assert_eq!(status, StatusCode::OK);
+    assert_eq!(v["status"], "delivered");
+    let sent = s.sent.lock().unwrap();
+    assert_eq!(sent.len(), 1);
+    assert!(matches!(sent[0].urgency, Some(Urgency::Interactive)));
+    assert!(sent[0].mediator.is_none() && sent[0].count.is_none());
+    let collapse = sent[0].collapse_id.as_deref().unwrap();
+    assert!(collapse.starts_with(message_wake::COLLAPSE_PREFIX));
+    assert!(
+        collapse.len() <= 64,
+        "APNs caps the collapse id at 64 bytes"
+    );
