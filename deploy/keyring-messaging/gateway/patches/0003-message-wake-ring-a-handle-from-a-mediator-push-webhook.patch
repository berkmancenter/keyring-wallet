new file mode 100644
index 0000000..472ecca
--- /dev/null
+++ b/src/message_wake.rs
@@ -0,0 +1,213 @@
+//! Message wakes: a DIDComm mediator's push webhook rings a handle's device.
+//!
+//! A mediator built on `didcomm-mediator-credo` can POST
+//! `{"connectionId": …, "fcmToken": …}` to one configured URL for every message
+//! it queues for a recipient it could not deliver to directly. The "token" is
+//! whatever the recipient handed the mediator in RFC 0734 `set-device-info`;
+//! a recipient using this gateway hands it its opaque wake **handle**, never a
+//! push-service token.
+//!
+//! The webhook is not a Trust Task and carries no proof, so it is gated three
+//! ways:
+//! - the URL holds a shared secret (`GATEWAY_MEDIATOR_WEBHOOK_SECRET`); a wrong
+//!   secret answers `404` as if the route did not exist;
+//! - the gateway wakes the handle as **its own** trigger DID: the handle's
+//!   controller must have put the gateway's DID on the allowlist (the device
+//!   asks for it in `suggestedTriggers`), so a handle whose controller did not
+//!   opt in is never rung this way;
+//! - at most one wake per handle per interval
+//!   (`GATEWAY_MESSAGE_WAKE_MIN_INTERVAL_SECS`, default 30), so a burst of
+//!   messages rings once.
+//!
+//! Each message wake is interactive (shown) and carries its own collapse id
+//! (`keyring-msg-…`), so it does not replace an earlier notification, and the
+//! app can tell a message wake from an approval wake when it is tapped.
+
+use std::collections::HashMap;
+use std::sync::{Arc, Mutex};
+use std::time::{Duration, Instant};
+
+use axum::{
+    body::Bytes,
+    extract::{DefaultBodyLimit, Path, State},
+    http::StatusCode,
+    response::{IntoResponse, Response},
+    routing::post,
+    Json, Router,
+};
+use serde::Deserialize;
+use serde_json::json;
+use uuid::Uuid;
+
+use crate::api::{AppState, WAKE_SEND_TIMEOUT};
+use crate::sender::{self, SendOutcome};
+use crate::store::WakeAuthz;
+use crate::types::{Urgency, WakePayload};
+
+/// Env var holding the webhook path secret; the route is off when unset.
+pub const ENV_WEBHOOK_SECRET: &str = "GATEWAY_MEDIATOR_WEBHOOK_SECRET";
+/// Env var setting the minimum seconds between two message wakes of one handle.
+pub const ENV_MIN_INTERVAL_SECS: &str = "GATEWAY_MESSAGE_WAKE_MIN_INTERVAL_SECS";
+/// Default minimum interval between two message wakes of one handle.
+pub const DEFAULT_MIN_INTERVAL: Duration = Duration::from_secs(30);
+/// Prefix of every message wake's collapse id.
+pub const COLLAPSE_PREFIX: &str = "keyring-msg-";
+
+/// The mediator's body is two short strings; refuse anything larger.
+const MAX_BODY_BYTES: usize = 2 * 1024;
+/// Shortest accepted secret.
+const MIN_SECRET_LEN: usize = 32;
+/// Above this many remembered handles, forget the ones outside the interval.
+const PRUNE_ABOVE: usize = 10_000;
+
+/// Message-wake configuration plus the per-handle rate-limit memory.
+pub struct MessageWake {
+    secret: String,
+    min_interval: Duration,
+    last_wake: Mutex<HashMap<String, Instant>>,
+}
+
+impl MessageWake {
+    /// Validate the operator's configuration: the secret is at least 32
+    /// characters of `[A-Za-z0-9_-]` (it sits in a URL path).
+    pub fn new(secret: String, min_interval: Duration) -> Result<Self, String> {
+        if secret.len() < MIN_SECRET_LEN
+            || !secret
+                .bytes()
+                .all(|b| b.is_ascii_alphanumeric() || matches!(b, b'_' | b'-'))
+        {
+            return Err(format!(
+                "{ENV_WEBHOOK_SECRET} must be at least {MIN_SECRET_LEN} characters of [A-Za-z0-9_-]"
+            ));
+        }
+        Ok(Self {
+            secret,
+            min_interval,
+            last_wake: Mutex::new(HashMap::new()),
+        })
+    }
+
+    /// Claim this handle's next wake slot: `false` if it was woken within the
+    /// interval. Recorded before the send, so concurrent posts ring once.
+    fn claim(&self, handle: &str, now: Instant) -> bool {
+        let mut last = self.last_wake.lock().unwrap();
+        if last
+            .get(handle)
+            .is_some_and(|t| now.duration_since(*t) < self.min_interval)
+        {
+            return false;
+        }
+        if last.len() >= PRUNE_ABOVE {
+            let interval = self.min_interval;
+            last.retain(|_, t| now.duration_since(*t) < interval);
+        }
+        last.insert(handle.to_string(), now);
+        true
+    }
+}
+
+#[derive(Clone)]
+struct Ctx {
+    state: AppState,
+    wake: Arc<MessageWake>,
+}
+
+/// The mediator webhook body (`didcomm-mediator-credo` `sendWebhookNotification`).
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase")]
+struct WebhookBody {
+    #[serde(default)]
+    fcm_token: Option<String>,
+}
+
+/// `POST /mediator-webhook/{secret}`.
+pub fn router(state: AppState, wake: Arc<MessageWake>) -> Router {
+    Router::new()
+        .route("/mediator-webhook/{secret}", post(webhook))
+        .layer(DefaultBodyLimit::max(MAX_BODY_BYTES))
+        .with_state(Ctx { state, wake })
+}
+
+fn status(s: &str) -> Response {
+    (StatusCode::OK, Json(json!({ "status": s }))).into_response()
+}
+
+/// Compare without an early exit, so the response time does not reveal a
+/// correct prefix of the secret.
+fn constant_time_eq(a: &[u8], b: &[u8]) -> bool {
+    if a.len() != b.len() {
+        return false;
+    }
+    a.iter().zip(b).fold(0u8, |acc, (x, y)| acc | (x ^ y)) == 0
+}
+
+async fn webhook(State(ctx): State<Ctx>, Path(secret): Path<String>, body: Bytes) -> Response {
+    if !constant_time_eq(secret.as_bytes(), ctx.wake.secret.as_bytes()) {
+        return StatusCode::NOT_FOUND.into_response();
+    }
+    // The mediator posts for every queued message, with a null token when the
+    // recipient never sent set-device-info: nothing to ring.
+    let Ok(body) = serde_json::from_slice::<WebhookBody>(&body) else {
+        return StatusCode::BAD_REQUEST.into_response();
+    };
+    let Some(handle) = body.fcm_token.filter(|h| !h.is_empty()) else {
+        return status("ignored");
+    };
+    let Some(gateway_did) = ctx.state.gateway_did.as_deref() else {
+        return (
+            StatusCode::SERVICE_UNAVAILABLE,
+            Json(json!({ "status": "noGatewayIdentity" })),
+        )
+            .into_response();
+    };
+    let registration = match ctx.state.store.authorize_wake(&handle, gateway_did) {
+        WakeAuthz::Allowed(reg) => reg,
+        WakeAuthz::UnknownHandle => {
+            ctx.state.metrics.inc_wake_unknown_handle();
+            return status("unknownHandle");
+        }
+        WakeAuthz::NotAllowed => {
+            ctx.state.metrics.inc_wake_not_allowed();
+            return status("notAllowed");
+        }
+    };
+    if !ctx.wake.claim(&handle, Instant::now()) {
+        return status("rateLimited");
+    }
+    let Some(s) = sender::select(&ctx.state.senders, &registration) else {
+        return status("noSender");
+    };
+    let payload = WakePayload {
+        v: 1,
+        mediator: None,
+        count: None,
+        urgency: Some(Urgency::Interactive),
+        collapse_id: Some(format!("{COLLAPSE_PREFIX}{}", Uuid::new_v4().simple())),
+    };
+    let outcome =
+        match tokio::time::timeout(WAKE_SEND_TIMEOUT, s.send(&registration, &payload)).await {
+            Ok(outcome) => outcome,
+            Err(_) => {
+                tracing::warn!(
+                    platform = registration.platform(),
+                    "message wake exceeded the wake timeout"
+                );
+                SendOutcome::TransientFailure
+            }
+        };
+    match outcome {
+        SendOutcome::Delivered => {
+            ctx.state.metrics.inc_wake_delivered();
+            status("delivered")
+        }
+        SendOutcome::TransientFailure => {
+            ctx.state.metrics.inc_wake_transient_failure();
+            status("transientFailure")
+        }
+        SendOutcome::PermanentlyUnregistered => {
+            ctx.state.store.remove(&handle);
+            ctx.state.metrics.inc_wake_token_unregistered();
+            status("tokenUnregistered")
+        }
+    }
+}
