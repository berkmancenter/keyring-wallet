# Copy to .env (gitignored) and fill in. docker compose reads .env from this
# directory. Nothing here is a secret: the mailbox's keys are in GCP Secret
# Manager (README "Identity and keys"). On the VM this file is rendered from
# Terraform; do not edit it there.

# PLACEHOLDER: the mailbox's public hostname, no scheme. Chosen by a reviewer
# from the servers already in use; it needs a DNS A record pointing at this
# server. The mailbox's DID is made on this hostname (setup-identity.sh), so
# choose it first and keep it: a new hostname is a new mailbox DID.
MAILBOX_HOSTNAME=

# https (default): Caddy gets certificates automatically.
# http: a local run, or behind a tunnel that terminates TLS.
SITE_SCHEME=https
HTTP_PORT=80
HTTPS_PORT=443

# The GCP project whose Secret Manager holds the mailbox's keys, and the prefix
# of its secret ids: the mediator reads <prefix>mediator_secrets_bundle.
GCP_PROJECT=
MAILBOX_SECRET_PREFIX=kpush-mailbox-

# Full 40-character commit of affinidi-messaging-mediator to build (v0.53.0),
# and the image tag: the commit plus -pN, N moving with every rebuild of the
# same commit (new features, a new base image, a Dockerfile change).
MEDIATOR_COMMIT=f6ed8159a761344a96b5256e09c10e36cd2359d7
MAILBOX_IMAGE_TAG=f6ed8159a761344a96b5256e09c10e36cd2359d7-p1

# The mailbox's DID (did:webvh:<scid>:<MAILBOX_HOSTNAME>) and its admin did:key,
# without a did:// prefix, as setup-identity.sh prints them. Empty until the
# identity exists; the mediator does not start without them.
MAILBOX_MEDIATOR_DID=
MAILBOX_ADMIN_DID=
