+
+  test('queries the wallet for ldp_vc credentials using the ldp_vc query entry, not a jwt_vc_json one', async () => {
+    // Regression test for a copy-paste bug: the ldp_vc branch of queryCredentialsForDcqlQuery
+    // filtered dcqlQuery.credentials for `c.format === 'jwt_vc_json'` instead of `'ldp_vc'`, so
+    // when a query contains only an ldp_vc credential (no jwt_vc_json one), the resulting $or was
+    // always `[]` and no W3C JSON-LD credential could ever be found.
+    const w3cCredentialRepository = { findByQuery: vi.fn().mockResolvedValue([]) }
+    const w3cV2CredentialRepository = { findByQuery: vi.fn().mockResolvedValue([]) }
+    const sdJwtVcApi = { findAllByQuery: vi.fn().mockResolvedValue([]), getAll: vi.fn().mockResolvedValue([]) }
+    const mdocApi = { findAllByQuery: vi.fn().mockResolvedValue([]), getAll: vi.fn().mockResolvedValue([]) }
+
+    const agentContext = {
+      dependencyManager: {
+        resolve: vi.fn((token) => {
+          if (token === W3cCredentialRepository) return w3cCredentialRepository
+          if (token === W3cV2CredentialRepository) return w3cV2CredentialRepository
+          if (token === SdJwtVcApi) return sdJwtVcApi
+          if (token === MdocApi) return mdocApi
+          throw new Error(`Unexpected dependencyManager.resolve call for ${token}`)
+        }),
+      },
+    } as unknown as AgentContext
+
+    const dcqlQuery = {
+      credentials: [
+        {
+          id: 'ldp-vc-cred',
+          format: 'ldp_vc',
+          require_cryptographic_holder_binding: true,
+          multiple: false,
+          meta: {
+            type_values: [['VerifiableCredential', 'ExampleCredential']],
+          },
+        },
+      ],
+    } as unknown as DcqlQuery
+
+    // queryCredentialsForDcqlQuery is private; reach it directly to test the query construction
+    // in isolation, without needing a full wallet/agent for the surrounding public method.
+    await (
+      dcqlService as unknown as { queryCredentialsForDcqlQuery: (...args: unknown[]) => Promise<unknown> }
+    ).queryCredentialsForDcqlQuery(agentContext, dcqlQuery)
+
+    expect(w3cCredentialRepository.findByQuery).toHaveBeenCalledWith(
+      agentContext,
+      expect.objectContaining({
+        claimFormat: ClaimFormat.LdpVc,
+        $or: [{ expandedTypes: ['VerifiableCredential', 'ExampleCredential'] }],
+      })
+    )
+  })
 })
