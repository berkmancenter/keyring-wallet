{
  "slug": "hcp-draft/connect",
  "version": "0.1",
  "title": "HCP connect (review draft, not for publication)",
  "summary": "A Context Client asks for a grant, the provider holds it and asks the person's Management Client, the person approves or declines, and the client collects the grant on the held thread.",
  "status": "draft",
  "targetFrameworkVersion": "0.6.0",
  "authors": [
    "review draft"
  ],
  "roles": {
    "context-client": {
      "description": "The agent asking for the grant.",
      "cardinality": "one"
    },
    "provider": {
      "description": "The HCP Provider and its Authorization Service.",
      "cardinality": "one"
    },
    "management-client": {
      "description": "The person's app, the approver.",
      "cardinality": "one"
    }
  },
  "steps": {
    "ask": {
      "kind": "task",
      "type": "https://trusttasks.org/spec/hcp/grants/request/0.1#request",
      "issuer": "context-client",
      "recipient": "provider",
      "prev": []
    },
    "hold": {
      "kind": "task",
      "type": "https://trusttasks.org/spec/trust-task-next-step/0.1",
      "issuer": "provider",
      "recipient": "context-client",
      "prev": [
        "ask"
      ],
      "optional": true,
      "maxRounds": 60
    },
    "consult": {
      "kind": "task",
      "type": "https://trusttasks.org/spec/task-consent/request/0.1",
      "issuer": "provider",
      "recipient": "management-client",
      "prev": [
        "ask"
      ]
    },
    "approve": {
      "kind": "task",
      "type": "https://trusttasks.org/spec/task-consent/decision/0.2",
      "issuer": "management-client",
      "recipient": "provider",
      "prev": [
        "consult"
      ],
      "optional": true
    },
    "decline": {
      "kind": "task",
      "type": "https://trusttasks.org/spec/task-consent/decision/0.2",
      "issuer": "management-client",
      "recipient": "provider",
      "prev": [
        "consult"
      ],
      "optional": true,
      "terminal": true,
      "compensatable": false
    },
    "collect": {
      "kind": "task",
      "type": "https://trusttasks.org/spec/hcp/grants/request/0.1#request",
      "issuer": "context-client",
      "recipient": "provider",
      "prev": [
        "ask"
      ],
      "optional": true,
      "maxRounds": 60
    },
    "grant": {
      "kind": "task",
      "type": "https://trusttasks.org/spec/hcp/grants/request/0.1#response",
      "issuer": "provider",
      "recipient": "context-client",
      "prev": [
        "collect",
        "approve"
      ],
      "optional": true,
      "terminal": true,
      "compensatable": true
    },
    "refuse": {
      "kind": "task",
      "type": "https://trusttasks.org/spec/trust-task-error/0.9",
      "issuer": "provider",
      "recipient": "context-client",
      "prev": [
        "collect",
        "decline"
      ],
      "optional": true,
      "terminal": true,
      "description": "After a decline, the next resubmission is refused permissionDenied (grants/request spec: a decline is permissionDenied)."
    }
  },
  "completion": {
    "allOf": [
      "ask",
      "consult",
      {
        "anyOf": [
          {
            "allOf": [
              "approve",
              "grant"
            ]
          },
          {
            "allOf": [
              "decline",
              "refuse"
            ]
          }
        ]
      }
    ]
  },
  "evidence": {
    "level": "receipt",
    "recorders": [
      "provider",
      "management-client"
    ]
  },
  "maxDuration": "PT2H",
  "enactmentPrivacy": "blinded",
  "sideEffects": {
    "level": "mutating",
    "rationale": "Creates a grant; revocable by hcp/grants/revoke."
  },
  "exposure": {
    "discloses": "secret",
    "actsAsSubject": false,
    "rationale": "The grant response carries a bearer token."
  }
}