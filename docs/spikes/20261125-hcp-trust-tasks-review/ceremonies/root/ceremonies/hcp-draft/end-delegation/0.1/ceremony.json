{
  "slug": "hcp-draft/end-delegation",
  "version": "0.1",
  "title": "HCP end delegation (review draft, not for publication)",
  "summary": "A delegate or the person ends a delegation; every grant under it ends and each client holding one is notified.",
  "status": "draft",
  "targetFrameworkVersion": "0.6.0",
  "authors": ["review draft"],
  "roles": {
    "management-client": { "description": "Acting for the delegate or the person.", "cardinality": "one" },
    "provider": { "description": "The HCP Provider.", "cardinality": "one" },
    "context-client": { "description": "Every client holding a grant under the delegation.", "cardinality": "many" }
  },
  "steps": {
    "end":         { "kind": "task", "type": "https://trusttasks.org/spec/hcp/delegations/end/0.1", "issuer": "management-client", "recipient": "provider", "prev": [], "terminal": true, "compensatable": false },
    "notify":      { "kind": "task", "type": "https://trusttasks.org/spec/hcp/grants/revoked/0.1#request", "issuer": "provider", "recipient": "context-client", "prev": ["end"], "optional": true },
    "acknowledge": { "kind": "task", "type": "https://trusttasks.org/spec/hcp/grants/revoked/0.1#response", "issuer": "context-client", "recipient": "provider", "prev": ["notify"], "optional": true, "multiplicity": "perRole" }
  },
  "completion": "end",
  "evidence": { "level": "receipt", "recorders": ["provider"] },
  "maxDuration": "P2D",
  "enactmentPrivacy": "blinded",
  "sideEffects": { "level": "destructive", "rationale": "Ends the delegation and every grant under it." },
  "exposure": { "discloses": "secret", "actsAsSubject": true, "rationale": "Correlating the notices across clients would reveal a shared delegation, which HCP 17.4 hides." }
}
