 {
  "id": "specification:2598",
  "file": "spec/2.0-draft-3/specification.md",
  "line": 2598,
  "heading": "10.3.3 hcp_createEntry",
  "http": null,
  "kind": "object",
  "template": false,
  "json": {
   "name": "hcp_createEntry",
   "description": "Add a new entry to the person's HCP instance.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "categories": {
      "type": "array",
      "items": {
       "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true,
      "description": "One or more category slugs or custom category URIs, each one the grant lets this client write."
     },
     "dimension": {
      "type": [
       "string",
       "null"
      ],
      "description": "Optional. Dimension addressed by this entry, scoped within its categories."
     },
     "content": {
      "type": "string",
      "description": "Natural language statement."
     },
     "declarationType": {
      "type": "string",
      "enum": [
       "person-declared",
       "model-inferred"
      ]
     },
     "confidence": {
      "type": [
       "string",
       "null"
      ],
      "enum": [
       "high",
       "medium",
       "low",
       null
      ],
      "description": "Required and non-null when declarationType is model-inferred; null or omitted otherwise."
     },
     "assertedBy": {
      "type": "string",
      "description": "The Context Asserter. Required when declarationType is model-inferred: identify the model, at a granularity that distinguishes versions."
     },
     "sourceContext": {
      "type": "string",
      "description": "Conversation or document ID from which this entry was derived."
     },
     "basis": {
      "type": "object",
      "properties": {
       "drawnFrom": {
        "type": "array",
        "items": {
         "type": "string"
        }
       },
       "task": {
        "type": "string"
       },
       "setting": {
        "type": "string"
       },
       "rationale": {
        "type": "string"
       }
      },
      "description": "Optional; recommended when declarationType is model-inferred. What this entry was drawn from. Must not identify anyone but the person, or carry any client, conversation or document identifier."
     },
     "permittedPurposes": {
      "type": "array",
      "items": {
       "type": "string",
       "format": "uri"
      },
      "description": "Optional. Purpose codes this entry may be used for."
     },
     "relationships": {
      "type": "array",
      "items": {
       "type": "object",
       "properties": {
        "type": {
         "type": "string",
         "enum": [
          "derivedFrom",
          "supersedes",
          "contradicts",
          "duplicates"
         ]
        },
        "target": {
         "type": "string",
         "description": "The related entry's ref."
        }
       },
       "required": [
        "type",
        "target"
       ]
      },
      "description": "Optional. Relationships this entry has to other entries."
     }
    },
    "required": [
     "categories",
     "content",
     "declarationType",
     "sourceContext"
    ],
    "allOf": [
     {
      "if": {
       "properties": {
        "declarationType": {
         "const": "model-inferred"
        }
       },
       "required": [
        "declarationType"
       ]
      },
      "then": {
       "required": [
        "confidence",
        "assertedBy"
       ],
       "properties": {
        "confidence": {
         "type": "string",
         "enum": [
          "high",
          "medium",
          "low"
         ]
        }
       }
      },
      "else": {
       "properties": {
        "confidence": {
         "type": "null"
        }
       }
      }
     }
    ]
   }
  }
 },
