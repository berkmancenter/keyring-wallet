#!/bin/sh
# Auto-append a Signed-off-by trailer if the message doesn't already have
# one, so nobody has to remember `-s`. commitlint (.husky/commit-msg) still
# rejects a commit with no trailer at all -- this just means that check
# should never actually fire in practice. See CLAUDE.md's Commit
# conventions section.

COMMIT_MSG_FILE="$1"

if [ -z "$COMMIT_MSG_FILE" ] || [ ! -f "$COMMIT_MSG_FILE" ]; then
  exit 0
fi

# Idempotent: a message that already carries one (hand-written, or this is
# a --amend of a commit we already signed off) is left untouched.
if grep -qi "^Signed-off-by:" "$COMMIT_MSG_FILE"; then
  exit 0
fi

name=$(git config user.name)
email=$(git config user.email)

# Nothing sane to write -- leave it to commitlint to reject with a clear
# error rather than inject a blank/malformed trailer.
if [ -z "$name" ] || [ -z "$email" ]; then
  exit 0
fi

if [ -s "$COMMIT_MSG_FILE" ]; then
  printf '\nSigned-off-by: %s <%s>\n' "$name" "$email" >> "$COMMIT_MSG_FILE"
else
  printf 'Signed-off-by: %s <%s>\n' "$name" "$email" >> "$COMMIT_MSG_FILE"
fi
