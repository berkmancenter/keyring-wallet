{
  "name": "keyring-e2e",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Appium E2E harness: fresh install, onboarding, and a two-device VRC exchange",
  "scripts": {
    "vrc-exchange": "node run-vrc-exchange.js",
    "vrc-exchange:tsp": "node run-vrc-exchange-tsp.js",
    "vrc-exchange:didcomm-v2": "node run-vrc-exchange-didcomm-v2.js",
    "vrc-exchange:witnessed:didcomm-v2": "node run-vrc-exchange-witnessed-didcomm-v2.js",
    "vrc-exchange:didcomm-v2:tsp": "node run-vrc-exchange-didcomm-v2-tsp.js",
    "vrc-exchange:witnessed:didcomm-v2:tsp": "node run-vrc-exchange-witnessed-didcomm-v2-tsp.js",
    "vrc-exchange:photo": "node run-vrc-exchange-photo.js",
    "vrc-exchange:trading-card": "node run-vrc-exchange-trading-card.js",
    "approver-exchange": "node run-approver-exchange.js",
    "plain-build-smoke": "node run-plain-build-smoke.js",
    "vrc-exchange:devices": "node run-vrc-exchange-devices.js",
    "store-migration": "node run-store-migration.js",
    "onboarding-smoke": "node run-onboarding-smoke.js",
    "vrc-exchange:witnessed:devices": "node run-vrc-exchange-witnessed-devices.js",
    "vrc-exchange:witnessed:ios-devices": "node run-vrc-exchange-witnessed-ios-devices.js",
    "vrc-exchange:witnessed:ios-devices:didcomm-v2": "E2E_DIDCOMM_V2=1 node run-vrc-exchange-witnessed-ios-devices.js",
    "vrc-exchange:witnessed:ios-devices:didcomm-v2:tsp": "E2E_DIDCOMM_V2=1 E2E_TSP=1 node run-vrc-exchange-witnessed-ios-devices.js",
    "vrc-exchange:witnessed:ios-devices:didcomm-v2:tsp:locality": "E2E_DIDCOMM_V2=1 E2E_TSP=1 E2E_LOCALITY=1 node run-vrc-exchange-witnessed-ios-devices.js",
    "vrc-exchange:witnessed:locality:devices": "node run-vrc-exchange-witnessed-locality-devices.js",
    "vrc-exchange:witnessed": "node run-vrc-exchange-witnessed.js",
    "credential-exchange-query": "node run-credential-exchange-query.js",
    "agent-connect": "node run-agent-connect.js",
    "agent-connect:ios": "PLATFORM=ios node run-agent-connect.js",
    "my-agent": "node run-my-agent.js",
    "my-agent:ios": "PLATFORM=ios node run-my-agent.js",
    "lock-probe": "node run-lock-probe.mjs"
  },
  "dependencies": {
    "@xterm/headless": "^6.0.0",
    "node-pty": "^1.1.0",
    "webdriverio": "^9.12.0"
  }
}
