# The gate's private configuration: copy to ~/.keyring-fleet/gate/env/farm.env (or lab.env) and fill it in.
# Never commit the filled-in file: it names Farm runners and holds a community admin credential.
# gate.sh reads it with `set -a; . file; set +a`, so values are plain shell assignments.

# What this file points the gate at: farm, or local (the fallback stack, scripts/openvtc/local-vti-stack, on the
# newest VTI release tag). Unset, it is the file's name: farm.env -> farm, local.env -> local. Every run's meta,
# report and HEADS lines carry it, so a local pass is never read as a Farm pass.
GATE_TARGET=

# pnm: the binary that speaks to these runners' vta-service version. PNM_HOME stays unset.
PNM_BIN=

# Runner agents (pnm slugs, their DIDs and REST bases).
# MAIN: the runner most legs link to. A and B: the several-agents leg's two agents.
# COMMUNITY_AGENT: a community's own agent, which a phone must refuse to link to (#306).
RUNNER_MAIN_SLUG=
RUNNER_MAIN_DID=
RUNNER_MAIN_URL=
RUNNER_MAIN_NAME=
RUNNER_A_SLUG=
RUNNER_A_DID=
RUNNER_A_URL=
RUNNER_A_NAME=
RUNNER_B_SLUG=
RUNNER_B_DID=
RUNNER_B_URL=
RUNNER_B_NAME=
COMMUNITY_AGENT_SLUG=
COMMUNITY_AGENT_DID=

# The community the legs join (C): its DID, display name, REST base and an admin credential that may decide
# join requests and remove test members (members.manage, join.decide).
C_DID=
C_NAME=
C_REST=
# lostreq's IN-258 row cuts only the status-list host. Its host when it isn't C_REST's (else C_REST's), and C's
# messaging host, which the cut must not reach (the row refuses when the two would overlap).
STATUS_LIST_HOST=
C_MEDIATOR_HOST=
C_ADMIN_CRED=
# The hv leg's community (hidden vetting, PCS): one the gate administers, never C, whose criteria other rows depend on
# (keyring-hv-lab1). Its DID, REST base, the harness admin credential (community-admin there) and the hidden-vetting
# criterion's id. Unset: the hv leg reports SKIP. HV_TUI_*: the openvtc TUI seated there as the hidden vetter.
HV_C_DID=
HV_C_REST=
HV_C_ADMIN_CRED=
HV_CRITERION=hv-vetted
HV_TUI_FX=
HV_TUI_PROFILE=
HV_TUI_PERSONA=
# hv's vetter is a seated Keyring by default (VETTER=keyring): an iOS simulator, a member of the hv community with a
# vetter grant and enrolled (e2e/openvtc/seat-hv-keyring-vetter.mjs). VETTER=tui uses the openvtc TUI above instead.
HV_VETTER_UDID=
HV_VETTER_NAME=
HV_VETTER_DID=

# Devices. The vetter simulator is seated (linked, a vetter of C) once, by hand, and never wiped by a leg.
VETTER_SIM_UDID=
VETTER_SIM_NAME=
VETTER_DID=
APPLICANT_SIM_UDID=
APPLICANT_SIM_NAME=
SMOKE_SIM_UDID=
SMOKE_SIM_NAME=
IOS_VERSION=
AVD=Pixel_6_API_33

# The openvtc TUI for P1 (vetter persona and its fixture).
OPENVTC_BIN=
OPENVTC_VERSION=
TUI_FX=
TUI_PROFILE=
TUI_PERSONA=

# P2 (legs/p2.sh): Keyring as the vetter, the openvtc TUI as the applicant. Empty, every p2 row SKIPs and says what
# is missing. P2_BLOCKED="<why>" skips them on purpose.
# The Keyring vetter: a phone seated once, by hand, and never wiped by a leg: onboarded, linked to a runner
# (P2_VETTER_RUNNER_SLUG, swept of the gate's own keys and rules after the leg), a member of C, and granted by C's
# admin (vtc-admin.mjs … vetter-grant <P2_VETTER_DID>), with its desk opened once so the grant is taken. Its app PIN
# is the harness's. The leg installs the candidate over it (keeping its data) and checks C lists a live grant for
# P2_VETTER_DID. ios (default): a simulator; it may be kk's VETTER_SIM_* (then p2 runs after kk, never beside it).
# android: an AVD of its own, never $AVD (the other legs wipe that one), started cold so the seat survives; the
# candidate APK must be signed with the key of the build seated there (adb install -r).
P2_VETTER_PLATFORM=ios
P2_VETTER_SIM_UDID=
P2_VETTER_SIM_NAME=
P2_VETTER_AVD=
P2_VETTER_DID=
P2_VETTER_RUNNER_SLUG=
# The TUI applicant: a fixture of its own (its own folder: setup-fixture.mjs writes the folder's unlock-code, so it
# cannot share p1's TUI_FX), set up with setup-fixture.mjs on a runner agent with a DID host
# (TUI_APPLICANT_SLUG, e.g. farm-runner-openvtc), at OPENVTC_VERSION. A persona is minted per run unless
# TUI_APPLICANT_PERSONA_LABEL and _DID name one to reuse; either way its membership of C is removed after the leg.
TUI_APPLICANT_FX=
TUI_APPLICANT_PROFILE=
TUI_APPLICANT_SLUG=
TUI_APPLICANT_PERSONA_LABEL=
TUI_APPLICANT_PERSONA_DID=
P2_BLOCKED=

# What the Farm runs, as the last check read it (pnm health, openapi sha): printed on every leg's HEADS line.
FARM_VERSIONS=

# Tuning.
GATE_PARALLEL_MIN_GB=15   # free disk needed to run the iOS and Android legs side by side
GATE_MEM_MIN_GB=3         # free+inactive memory a leg needs before it boots a device
