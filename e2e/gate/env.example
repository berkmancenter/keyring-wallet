# The gate's private configuration: copy to ~/.keyring-fleet/gate/env/farm.env (or lab.env) and fill it in.
# Never commit the filled-in file: it names Farm runners and holds a community admin credential.
# gate.sh reads it with `set -a; . file; set +a`, so values are plain shell assignments.

# pnm: the binary that speaks to these runners' vta-service version. PNM_HOME stays unset.
PNM_BIN=

# Runner agents (pnm slugs, their DIDs and REST bases).
# MAIN: the runner most legs link to. A and B: the several-agents leg's two agents.
# COMMUNITY_AGENT: a community's own agent, which a phone must refuse to link to (#306).
RUNNER_MAIN_SLUG=
RUNNER_MAIN_DID=
RUNNER_MAIN_URL=
RUNNER_A_SLUG=
RUNNER_A_DID=
RUNNER_A_URL=
RUNNER_A_NAME=
RUNNER_B_SLUG=
RUNNER_B_DID=
RUNNER_B_URL=
RUNNER_B_NAME=
COMMUNITY_AGENT_SLUG=
COMMUNITY_AGENT_DID=

# The community the legs join (C): its DID, display name, REST base and an admin credential that may decide
# join requests and remove test members (members.manage, join.decide).
C_DID=
C_NAME=
C_REST=
C_ADMIN_CRED=

# Devices. The vetter simulator is seated (linked, a vetter of C) once, by hand, and never wiped by a leg.
VETTER_SIM_UDID=
VETTER_SIM_NAME=
VETTER_DID=
APPLICANT_SIM_UDID=
APPLICANT_SIM_NAME=
SMOKE_SIM_UDID=
SMOKE_SIM_NAME=
IOS_VERSION=
AVD=Pixel_6_API_33

# The openvtc TUI for P1 (vetter persona and its fixture).
OPENVTC_BIN=
OPENVTC_VERSION=
TUI_FX=
TUI_PROFILE=
TUI_PERSONA=

# Tuning.
GATE_PARALLEL_MIN_GB=15   # free disk needed to run the iOS and Android legs side by side
GATE_MEM_MIN_GB=3         # free+inactive memory a leg needs before it boots a device
