+++ b/build/modules/dids/domain/service/ServiceTransformer.mjs
@@ -25,9 +25,37 @@ const serviceTypes = {
 *   private service: Service
 * }
 */
+// DID Core allows `service.type` to be a string OR a set of strings, and
+// Credo's classes only accept a string: `DidDocumentService.type` carries a
+// plain `@IsString()`, so a document declaring `type: ["DIDCommMessaging"]`
+// fails class validation and the WHOLE document is discarded — the caller sees
+// only `notFound`. Measured 2026-09-20 against the VTA Farm, whose mediator
+// declares `#service` as `["DIDCommMessaging"]` and `#auth` as
+// `["Authentication"]`; the wallet could not resolve its mediator at all.
+//
+// The producer is conformant, so the fix belongs here. A single-element array
+// is collapsed to its string before the JSON reaches the class, which is the
+// shape every consumer already expects: validation passes, and equality checks
+// such as `service.type === DidCommV2Service.type` keep working. Longer arrays
+// are left alone rather than guessed at — picking one of several types is a
+// decision this transformer has no basis to make, and DID Core gives no
+// precedence rule.
+//
+// Note `serviceTypes[serviceJson.type]` already selects the right class for an
+// array, because indexing coerces `["DIDCommMessaging"]` to the same string.
+// It was never the lookup that failed, only the validation afterwards.
+function normalizeServiceType(serviceJson) {
+	if (!serviceJson || !Array.isArray(serviceJson.type)) return serviceJson;
+	if (serviceJson.type.length !== 1 || typeof serviceJson.type[0] !== "string") return serviceJson;
+	return {
+		...serviceJson,
+		type: serviceJson.type[0]
+	};
+}
 function ServiceTransformer() {
 	return Transform(({ value }) => {
-		return value?.map((serviceJson) => {
+		return value?.map((rawServiceJson) => {
+			const serviceJson = normalizeServiceType(rawServiceJson);
 			let serviceClass = serviceTypes[serviceJson.type] ?? DidDocumentService;
 			if (serviceJson.type === DidCommV2Service.type && "serviceEndpoint" in serviceJson && typeof serviceJson.serviceEndpoint === "string") serviceClass = LegacyDidCommV2Service;
 			return JsonTransformer.fromJSON(serviceJson, serviceClass);
