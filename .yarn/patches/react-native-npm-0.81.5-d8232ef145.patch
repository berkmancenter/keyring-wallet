 namespace facebook::react {
 
+// KEYRING PATCH (react-native#55719, merged upstream as 5229e507e1a1):
+// building the fragment with a full ShadowView retains the node's `state`,
+// chaining every TextInputState revision to the previous one. The chain is
+// destroyed recursively on the Hermes GC thread ("hades"), whose small stack
+// overflows after enough keystrokes -> SIGBUS/EXC_BAD_ACCESS crash observed
+// on real iPhones during the VRC E2E flow.
+inline ShadowView textInputShadowViewFromShadowNode(
+    const ShadowNode& shadowNode) {
+  auto shadowView = ShadowView{shadowNode};
+  // Clearing `props` and `state` (which we don't use) allows avoiding retain
+  // cycles.
+  shadowView.props = nullptr;
+  shadowView.state = nullptr;
+  return shadowView;
+}
+
 /*
