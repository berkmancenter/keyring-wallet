{
  "extends": "../tsconfig-base.json",
  "compilerOptions": {
    "outDir": "./lib",
    "declaration": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@assets/*": ["src/assets/*"],
      "@keyring-theme/*": ["src/keyring-theme/*"],
      "@components/*": ["src/components/*"],
      "@events/*": ["src/events/*"],
      "@hooks/*": ["src/hooks/*"],
      "@screens/*": ["src/screens/*"],
      "@services/*": ["src/services/*"],
      "@types/*": ["src/types/*"],
      "@utils/*": ["src/utils/*"],
      "react-native": ["node_modules/react-native"],
      "react-native-svg": ["node_modules/react-native-svg"],
      "@react-navigation/*": ["node_modules/@react-navigation/*"]
    }
  },
  "exclude": ["node_modules", "metro.config.js", "babel.config.js", "jest.config.js", "jestSetup.js"]
}
