{
  "extends": "../tsconfig-base.json",
  "compilerOptions": {
    "outDir": "./lib",
    "declaration": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@assets/*": ["src/assets/*"],
      "@keyring-theme/*": ["src/keyring-theme/*"],
      "@components/*": ["src/components/*"],
      "@events/*": ["src/events/*"],
      "@hooks/*": ["src/hooks/*"],
      "@screens/*": ["src/screens/*"],
      "@services/*": ["src/services/*"],
      "@types/*": ["src/types/*"],
      "@utils/*": ["src/utils/*"],
      // The framework's packages (workspaces at ../packages, one install since Phase 2 of the fold) declare
      // "types": "src/index.ts", so a bare @bifold/* import resolves to source through node_modules with no
      // mapping. The oca subpaths are the exception: `@bifold/oca/build/legacy` is the import spelling the
      // framework kept from the days oca was built, served by oca's package.json "exports" to src/legacy at
      // runtime (Metro and jest read exports); this tsconfig's moduleResolution does not, so map them here.
      "@bifold/oca/build/legacy": ["../packages/oca/src/legacy/index.ts"],
      "@bifold/oca/build/legacy/*": ["../packages/oca/src/legacy/*"],
      "@bifold/oca/build/*": ["../packages/oca/src/*"],
      "react-native": ["node_modules/react-native"],
      "react-native-svg": ["node_modules/react-native-svg"],
      "@react-navigation/*": ["node_modules/@react-navigation/*"],
      "@openvtc/trust-tasks": ["../node_modules/@openvtc/trust-tasks/dist/index.d.ts"],
      "@openvtc/trust-tasks/*": ["../node_modules/@openvtc/trust-tasks/dist/*"],
      // ./runtime is the one export whose file is not dist/<path> (metro.config.js and bifold's tsconfig map it too).
      "@openvtc/trust-tasks/runtime": ["../node_modules/@openvtc/trust-tasks/dist/_runtime/index.d.ts"]
    }
  },
  "exclude": ["node_modules", "metro.config.js", "babel.config.js", "jest.config.js", "jestSetup.js"]
}
