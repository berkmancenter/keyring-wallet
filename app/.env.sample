# OCA_URL sourced from upstream bcgov/aries-oca-bundles repository
OCA_URL=https://raw.githubusercontent.com/bcgov/aries-oca-bundles/main/
# Filled in by `yarn mediator` at the repo root, which starts a local DIDComm
# mediator and writes a live invitation here. Nothing in the app boots usefully
# without one. See bifold/packages/mediator-server/README.md.
# Left empty on purpose: this used to carry a captured ngrok invitation, which
# had gone dead and failed late, as "There is no mediator to pickup messages from".
MEDIATOR_URL=
# Out-of-band/2.0 invitation of a DIDComm v2 mediator, used only when the
# Developer > "Enable DIDComm v2" setting is on; `yarn mediator --didcomm-v2`
# fills it. Blank keeps the wallet on v1 mediation only.
MEDIATOR_V2_URL=
MEDIATOR_USE_PUSH_NOTIFICATIONS=false
LOAD_STORYBOOK=false
PROOF_TEMPLATE_URL=
REMOTE_LOGGING_URL=
INDY_VDR_PROXY_URL=

# To example Verifiable Relationship Credential (VRC) debugging
# VRC_DEBUG=true

# ACTIVE_DEMO_PROFILE selects which demo-profiles/ profile(s) register on boot
# (see app/src/demo-profiles/README.md) — unset registers all, a profile id
# narrows to one, "none" excludes all for a plain Keyring build.
# ACTIVE_DEMO_PROFILE=none

# Local VTI stack (dev only) — the mediator a VTA/VTC advertises, and the
# community to probe. Both change whenever the local stack re-tunnels.
VTI_MEDIATOR_DID=
VTI_COMMUNITY_DID=
