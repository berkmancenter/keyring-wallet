# OCA_URL sourced from upstream bcgov/aries-oca-bundles repository
OCA_URL=https://raw.githubusercontent.com/bcgov/aries-oca-bundles/main/
# Filled in by `yarn mediator` at the repo root, which starts a local DIDComm
# mediator and writes a live invitation here. Nothing in the app boots usefully
# without one. See bifold/packages/mediator-server/README.md.
# Left empty on purpose: this used to carry a captured ngrok invitation, which
# had gone dead and failed late, as "There is no mediator to pickup messages from".
MEDIATOR_URL=
# DID of the Affinidi mediator that hosts this phone's DIDComm v2 wallet
# mailbox (bifold walletMailbox.ts). Opened only with Developer > "DIDComm v2
# mailbox" on. Blank (as in every build until Keyring's own Affinidi mediator
# is deployed): no mailbox, and the phone mints v1 invitations.
MAILBOX_MEDIATOR_DID=
# Where "Report this problem" offers to email the report (CI bakes the
# FEEDBACK_EMAIL repository variable). Empty: share sheet only.
FEEDBACK_EMAIL=
# Push wake-ups (docs/plans/push-notifications-plan.md): the HTTPS base URL of
# the push gateway this phone registers its push token with. Empty = push off,
# which is what a shipped build carries. Test builds only, until the plan's
# test passes.
PUSH_GATEWAY_URL=
# iOS only: `production` for a distribution-signed build; anything else (or
# empty) registers the APNs token for the sandbox, as a development build needs.
PUSH_APNS_ENVIRONMENT=
# Over-the-air JS updates (src/ota/withOta.tsx): the HTTPS base URL of the
# update server's update-check routes, ending in /hot-updater. Empty = off,
# which is what a shipped build carries until the OTA plan says otherwise: the
# app then never contacts an update server and runs the bundle it shipped with.
OTA_UPDATE_URL=
LOAD_STORYBOOK=false
PROOF_TEMPLATE_URL=
REMOTE_LOGGING_URL=
INDY_VDR_PROXY_URL=

# To example Verifiable Relationship Credential (VRC) debugging
# VRC_DEBUG=true

# ACTIVE_DEMO_PROFILE selects which demo-profiles/ profile(s) register on boot
# (see app/src/demo-profiles/README.md). Unset (or "none") registers none: a
# plain Keyring build, which is what ships. A profile id registers that one
# (e2e:approver needs "approver", the trading-card exchange "trading-card");
# "all" registers every installed profile.
# ACTIVE_DEMO_PROFILE=approver

# Local VTI stack (dev only) — the mediator a VTA/VTC advertises, and the
# community to probe. Both change whenever the local stack re-tunnels.
VTI_MEDIATOR_DID=
VTI_COMMUNITY_DID=
# Run the Developer screen's VTA probe as soon as that screen opens. Driving the
# button through Appium costs an onboarding lap per iteration; the transport it
# exercises is the same either way.
VTI_PROBE_ON_START=
# The personal VTA this phone manages, and where its serverless personas are served.
VTI_VTA_DID=
VTI_PERSONA_BASE_URL=
# What the peer leg (applicant <-> vetter) sends over the mediator socket:
# `tsp` for TSP Rev 3 frames, anything else for DIDComm v2 plaintexts. A
# build-time choice; a wallet reads both regardless.
VTI_PEER_LEG=

# Agent connect and its rooms tier are in this build (development and test builds only). Store, TestFlight and
# Play builds never carry it: staging.yaml refuses a .env that does (decided 2026-11-28). Remove the line to see
# the app as a store build sees it, without the agent-connect switches.
KEYRING_AGENT_CONNECT_BUILD=1
