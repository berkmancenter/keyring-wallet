#!/usr/bin/env bash
# pnm, one call per pnm identity at a time on this machine.
#   pnm-locked --vta <slug> <pnm arguments...>
#
# pnm keeps one admin key per slug (the OS keychain, service `pnm-cli`, account
# `vta:<slug>`), whatever PNM_HOME or HOME say. Two pnm calls on the same slug
# are therefore one DID with two connections, and the mediator keeps one live
# socket per DID: the older call's socket is closed ("replaced by a newer
# connection"), or, on a mediator with the duel damper, the newer one is refused
# ("this DID already has a live connection"). Either way a call fails with a
# dropped transport, not an answer (92's 220 gate, 2026-09-24).
#
# So every session, script and gate on this Mac takes the slug's lock first. The
# lock is a perl flock on $PNM_LOCK_DIR/<slug>.lock, held by pnm itself across
# exec and released by the kernel when pnm exits, however it exits: there is no
# stale lock to clean up. Different slugs never wait for each other.
#
#   PNM_BIN        pnm binary (default ~/vti-stack/bin/pnm, the signed build; see sign-lab-tool.sh)
#   PNM_LOCK_DIR   lock directory (default ~/.keyring-pnm-locks)
#   PNM_LOCK_WAIT  seconds to wait for the lock before giving up (default 300;
#                  giving up exits 75, before pnm runs)
#   PNM_CALL_TIMEOUT  seconds pnm itself may run once it holds the lock (default: no limit). Past it, pnm and
#                  whatever it started are killed and this exits 124 with a line saying so. The lock wait is not
#                  counted: a call queued behind another is not a hung one. The gate's legs set it (lib.sh pnm), so
#                  a call on a dying transport fails in minutes instead of holding a leg until its job's limit
#                  (the CI lane's linkfail rerun, 38806968457, 2026-10-15: a pnm call hung on a dropping TSP socket until
#                  the job's 90-minute cancel). Stopping pnm-locked (TERM, INT, HUP) stops pnm's group too, so a stopped
#                  leg never leaves a hung pnm holding the slug's lock.
set -uo pipefail
PNM="${PNM_BIN:-$HOME/vti-stack/bin/pnm}"
if [ "${1:-}" != --vta ] || [ -z "${2:-}" ]; then
  echo "pnm-locked: the first arguments must be --vta <slug>" >&2
  exit 2
fi
case "$2" in */* | .* ) echo "pnm-locked: not a slug: $2" >&2; exit 2 ;; esac
DIR="${PNM_LOCK_DIR:-$HOME/.keyring-pnm-locks}"
mkdir -p "$DIR" || exit 2

exec perl -MFcntl=:flock -e '
  my ($lock, $wait, $slug, @cmd) = @ARGV;
  $^F = 255; # keep the lock descriptor open across exec, so pnm holds it
  open(my $fh, "+>>", $lock) or die "pnm-locked: cannot open $lock: $!\n";
  my $deadline = time + $wait;
  my $told = 0;
  until (flock($fh, LOCK_EX | LOCK_NB)) {
    if (time >= $deadline) {
      seek($fh, 0, 0); my $holder = <$fh> // "?"; chomp $holder;
      print STDERR "pnm-locked: gave up after ${wait}s waiting for pnm on $slug (held by $holder)\n";
      exit 75; # EX_TEMPFAIL
    }
    unless ($told++) {
      seek($fh, 0, 0); my $holder = <$fh> // "?"; chomp $holder;
      print STDERR "pnm-locked: waiting for another pnm call on $slug (held by $holder)\n";
    }
    select(undef, undef, undef, 0.5);
  }
  truncate($fh, 0);
  syswrite($fh, "pid $$ since " . gmtime() . " UTC\n");
  my $cap = $ENV{PNM_CALL_TIMEOUT} // "";
  exec { $cmd[0] } @cmd or die "pnm-locked: cannot run $cmd[0]: $!\n" unless $cap =~ /^[1-9][0-9]*$/;
  # Capped: pnm runs as a child in its own process group (the lock stays held here, and by the child through the
  # inherited descriptor, until both have exited); past the cap the whole group is killed.
  my $p = fork; die "pnm-locked: fork: $!\n" unless defined $p;
  if (!$p) { setpgrp(0, 0); exec { $cmd[0] } @cmd or die "pnm-locked: cannot run $cmd[0]: $!\n" }
  # pnm is in its own group, so nothing reaches it when this process is stopped (a trap in the leg, the group kill of
  # galarm, a bootout): forward the stop, or a hung pnm would outlive us holding the slug lock with no alarm left.
  my $stop = sub { my ($code) = @_; kill "TERM", -$p; select(undef, undef, undef, 2); kill "KILL", -$p; waitpid($p, 0); exit $code };
  local $SIG{TERM} = sub { $stop->(143) };
  local $SIG{INT} = sub { $stop->(130) };
  local $SIG{HUP} = sub { $stop->(129) };
  local $SIG{ALRM} = sub {
    print STDERR "pnm-locked: pnm on $slug did not finish within ${cap}s (PNM_CALL_TIMEOUT); killed\n";
    $stop->(124);
  };
  alarm $cap; waitpid($p, 0); alarm 0;
  exit($? & 127 ? 128 + ($? & 127) : $? >> 8);
' "$DIR/$2.lock" "${PNM_LOCK_WAIT:-300}" "$2" "$PNM" "$@"
