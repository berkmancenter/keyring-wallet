{
  "$comment": "AUTHORED BY THIS RUNG. Issue #52 names meta/predicate.schema.json but does not publish it. This transcribes the nine points a profile MUST state (PR #47 @ bc1fd88, 'Predicate Profiles') plus the registry metadata members the two worked entries in #52 actually use. Where #47 says 'if the predicate constrains it' or 'any', the member is optional here.",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["id", "type", "status", "label", "definition", "classification", "objectKind", "taskContextRequired", "issuer", "establishes", "doesNotEstablish"],
  "properties": {
    "@context": { "type": "string" },
    "id": { "type": "string", "pattern": "^https://[^#]+#[^#]+$" },
    "type": { "const": "Predicate" },
    "status": { "enum": ["proposed", "active", "deprecated"] },
    "since": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "label": { "type": "object", "required": ["en"], "additionalProperties": { "type": "string" } },
    "definition": { "type": "object", "required": ["en"], "additionalProperties": { "type": "string" } },
    "classification": { "enum": ["evidence", "assertion"] },
    "weighedBy": { "type": "string" },
    "objectKind": { "type": "array", "minItems": 1, "items": { "enum": ["id", "digestMultibase", "value"] } },
    "valueSchema": { "type": "string" },
    "subjectObjectRelationship": { "type": "string" },
    "additionalMembers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["required"],
        "properties": { "required": { "type": "boolean" }, "schema": { "type": "string" } }
      }
    },
    "taskContextRequired": { "type": "boolean" },
    "minimumIssuerScope": { "enum": ["pairwise", "directed", "public"] },
    "issuer": { "type": "string" },
    "establishes": { "type": "string" },
    "doesNotEstablish": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "definedIn": { "type": "string" },
    "governedBy": { "type": ["string", "null"] }
  },
  "allOf": [
    { "if": { "properties": { "status": { "const": "active" } } }, "then": { "required": ["since"] } },
    { "if": { "properties": { "objectKind": { "contains": { "const": "value" } } } }, "then": { "required": ["valueSchema"] } }
  ]
}
